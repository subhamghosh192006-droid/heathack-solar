# HeatHack Solar — Backend Environment Variables
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Google Gemini API key (for vision suggestions, utility bill OCR, and multilingual advisory)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Default Solar Sizing Parameters
DEFAULT_PANEL_WATTAGE=500
DEFAULT_PANEL_LENGTH_M=2.0
DEFAULT_PANEL_WIDTH_M=1.05
DEFAULT_MONTHLY_YIELD_KWH_PER_KW=120
DEFAULT_BENCHMARK_COST_PER_KW=60000

# Default Cool Roof Cost Parameters (INR)
DEFAULT_COOL_ROOF_RATE_PER_SQM=100.0
DEFAULT_SURFACE_PREP_COST=1000.0
